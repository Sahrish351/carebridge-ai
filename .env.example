# ==============================================================================
# CareBridge AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# In Vercel, add these keys under: Project Settings -> Environment Variables.
# NEVER commit your real .env or secrets to Git.
# ==============================================================================

# 1. SUPABASE (Required for persistent production storage on Vercel)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 2. GOOGLE GEMINI AI (Optional)
# Obtain from: https://aistudio.google.com/
# If omitted or left as default, CareBridge AI runs safely with its built-in
# evidence-grounded oncology knowledge base citing NCI, ACS, Mayo Clinic, and WHO.
GEMINI_API_KEY="AIzaSy..."

# 3. SERVER CONFIGURATION
# Local development server port (defaults to 3000 if omitted)
PORT=3000
NODE_ENV="development"
